class Solution {
    public static ArrayList<Integer> maxNeighbour(ArrayList<Integer> arr) {
        // code here


                ArrayList<Integer> result = new ArrayList<>();

                for (int i = 0; i < arr.size() - 1; i++) {

                    int max = Math.max(arr.get(i), arr.get(i + 1));

                    result.add(max);
                }

                return result;
            }
        }
    
