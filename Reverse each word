class Solution {
    String reverseWords(String s) {

        String arr[] = s.split("\\.");
        String ans = "";

        for (int i = arr.length - 1; i >= 0; i--) {

            if (!arr[i].equals("")) {

                if (ans.equals(""))
                    ans = arr[i];
                else
                    ans = ans + "." + arr[i];
            }
        }

        return ans;
    }
}
