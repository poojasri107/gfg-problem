class Solution {
    public void printPattern(int n) {
       

                for (int i = 1; i <= n; i++) {

                    // Last row
                    if (i == n) {

                        for (int j = 1; j <= n; j++) {
                            System.out.print("* ");
                        }

                    } else {

                        // First *
                        System.out.print("*");

                        // Spaces and last *
                        for (int j = 2; j <= i; j++) {

                            if (j == i)
                                System.out.print(" *");
                            else
                                System.out.print("  ");
                        }
                    }

                    System.out.println();
                }
            }
        }
    
