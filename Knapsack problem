class Solution {
    static int knapSack(int val[], int wt[], int capacity) {
        int[] dp = new int[capacity + 1];

        for (int i = 0; i <= capacity; i++) {
            for (int j = 0; j < val.length; j++) {

                if (wt[j] <= i) {
                    dp[i] = Math.max(
                        dp[i],
                        dp[i - wt[j]] + val[j]
                    );
                }
            }
        }

        return dp[capacity];
    }
}
